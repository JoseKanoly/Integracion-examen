<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">🎓 EduPlatform · Portal</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard">
                        <span class="bi bi-credit-card-fill-nav-menu" aria-hidden="true"></span> Mi Suscripción
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="historial">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Historial de Pagos
                    </NavLink>
                </div>

                <div class="nav-item px-3 mt-3 border-top border-secondary pt-3">
                    <div class="nav-link text-white-50 small">
                        <i class="bi bi-person-fill"></i> @context.User.Identity?.Name
                    </div>
                    <form action="logout" method="post" class="px-2">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-outline-light btn-sm w-100">
                            Cerrar Sesión
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Iniciar Sesión
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="registro">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Crear Cuenta
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
