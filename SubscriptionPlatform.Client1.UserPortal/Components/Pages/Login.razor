@page "/login"
@layout SubscriptionPlatform.Client1.UserPortal.Components.Layout.AuthLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using SubscriptionPlatform.Client1.UserPortal.Services
@inject ISubscriptionService SubscriptionService
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión - EduPlatform</PageTitle>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">🎓</div>
            <h2>Bienvenido de vuelta</h2>
            <p class="text-muted">Inicia sesión para gestionar tu suscripción</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2" role="alert">
                <i class="bi bi-exclamation-circle"></i> @errorMessage
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="HandleLogin" FormName="loginForm">
            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <InputText @bind-Value="Input.Email" class="form-control form-control-lg"
                           placeholder="tu@email.com" type="email" autocomplete="username" />
            </div>
            <div class="mb-4">
                <label class="form-label">Contraseña</label>
                <InputText @bind-Value="Input.Password" class="form-control form-control-lg"
                           placeholder="••••••••" type="password" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 auth-btn">
                Iniciar Sesión
            </button>
        </EditForm>

        <div class="auth-footer">
            ¿No tienes cuenta?
            <a href="/registro">Regístrate gratis</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginRequest Input { get; set; } = new();

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string errorMessage = "";

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(Input.Email) || string.IsNullOrWhiteSpace(Input.Password))
        {
            errorMessage = "Ingresa tu email y contraseña";
            return;
        }

        var result = await SubscriptionService.LoginAsync(Input);

        if (!result.Success)
        {
            errorMessage = result.Message;
            return;
        }

        // SSR estático: aquí sí es posible emitir la cookie porque la respuesta HTTP aún no comenzó
        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, result.UserId.ToString()),
            new(ClaimTypes.Email, result.Email),
            new(ClaimTypes.Name, result.FullName)
        };

        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);

        await HttpContext!.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identity),
            new AuthenticationProperties { IsPersistent = true });

        Navigation.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/dashboard" : ReturnUrl, forceLoad: true);
    }
}
